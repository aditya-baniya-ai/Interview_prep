{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://interview-prep-cb612.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://interview-prep-cb612.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
