# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# code-review-graph cache
.code-review-graph/

# context-mode (MCP server — local session DBs and indexed content)
.context-mode/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/auth.json

# python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# secrets — never commit these
serviceAccountKey.json
**/serviceAccountKey.json
*.serviceAccount*.json
.DS_Store
